<UserControl x:Class="StockHelper.App.Controls.BarChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:StockHelper.App.Behaviors"
             x:Name="Root">
    <!-- Bars: ItemsSource = BarPoint (Label, ValueText, Ratio 0..1, Tooltip, IsHighlighted). -->
    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="6,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Plot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding EmptyLength}" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding BarLength}" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="1" Style="{StaticResource Text.Caption}" Text="{Binding ValueText}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <Border x:Name="Bar" Grid.Row="2" CornerRadius="5,5,2,2" MaxWidth="56" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Opacity="0.45" b:Motion.OnLoaded="Grow" />
                    </Grid>
                    <TextBlock Grid.Row="1" Style="{StaticResource Text.Caption}" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                        <Setter TargetName="Bar" Property="Opacity" Value="1" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
