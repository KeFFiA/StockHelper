<UserControl x:Class="StockHelper.App.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="280">
    <Grid>
        <TextBox x:Name="Input" Padding="34,0,10,0" VerticalContentAlignment="Center"
                 Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Icon.Search}" FontSize="{StaticResource FontSize.Caption}"
                   Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock x:Name="PlaceholderText" Style="{StaticResource Text.Secondary}" Margin="35,0,0,0" VerticalAlignment="Center"
                   IsHitTestVisible="False" Text="{Binding Placeholder, ElementName=Root}" />
    </Grid>
</UserControl>
