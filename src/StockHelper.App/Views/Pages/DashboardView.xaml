<UserControl x:Class="StockHelper.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:DashboardViewModel}">
    <Grid Margin="{StaticResource Space.Page}">
        <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
    </Grid>
</UserControl>
