<UserControl x:Class="StockHelper.App.Views.Pages.ReceiptsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:StockHelper.App.Controls"
             xmlns:res="clr-namespace:StockHelper.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:ReceiptsViewModel}">
    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Style="{StaticResource PageHeader}" Header="{Binding Title}" Tag="{Binding Summary}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Export}"
                        Content="{x:Static res:Strings.Common_ExportExcel}" Command="{Binding ExportCommand}" />
                <Button Style="{StaticResource Button.AccentIcon}" Tag="{StaticResource Icon.Add}" Margin="{StaticResource Space.ButtonGap}"
                        Content="{x:Static res:Strings.Receipts_Add}" Command="{Binding AddCommand}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </HeaderedContentControl>

        <DockPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Receipts_SearchPlaceholder}" />

            <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Common_From}" VerticalAlignment="Center" Margin="16,0,8,0" />
            <DatePicker SelectedDate="{Binding FromDate}" Width="150" />
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Common_To}" VerticalAlignment="Center" Margin="12,0,8,0" />
            <DatePicker SelectedDate="{Binding ToDate}" Width="150" />

            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="3" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.Period_7}" Command="{Binding SetPeriodCommand}" CommandParameter="7" />
                    <Button Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.Period_30}" Command="{Binding SetPeriodCommand}" CommandParameter="30" />
                    <Button Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.Period_90}" Command="{Binding SetPeriodCommand}" CommandParameter="90" />
                    <Button Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.Period_All}" Command="{Binding SetPeriodCommand}" CommandParameter="0" />
                </StackPanel>
            </Border>

            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Refresh}"
                    ToolTip="{x:Static res:Strings.Common_Refresh}" Command="{Binding LoadCommand}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.Flush}">
                <Grid>
                    <DataGrid Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding ReceiptsView}" SelectedItem="{Binding SelectedReceipt}">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:Strings.Receipts_Date}" Width="Auto" MinWidth="140" SortMemberPath="Date"
                                                Binding="{Binding Date, Converter={StaticResource UtcToLocal}, ConverterParameter=g}"
                                                ElementStyle="{StaticResource Cell.Secondary}" />
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Items_Name}" Width="2*" MinWidth="200" SortMemberPath="Item.Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Item.Name}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Note}"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Receipts_Quantity}" Width="Auto" MinWidth="90" SortMemberPath="Quantity"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Cell.Number}">
                                            <Run Text="{Binding Quantity, Converter={StaticResource Decimal}, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Item.Unit.Name, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static res:Strings.Receipts_Price}" Width="Auto" MinWidth="90" SortMemberPath="Price"
                                                HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                Binding="{Binding Price, Converter={StaticResource Decimal}, ConverterParameter=#\,0.00}"
                                                ElementStyle="{StaticResource Cell.Number}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Receipts_Amount}" Width="Auto" MinWidth="96" SortMemberPath="Amount"
                                                HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                Binding="{Binding Amount, Converter={StaticResource Decimal}, ConverterParameter=#\,0.00}"
                                                ElementStyle="{StaticResource Cell.Number}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Receipts_Location}" Width="*" MinWidth="110" Binding="{Binding StorageLocation.Name}"
                                                ElementStyle="{StaticResource Cell.Secondary}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Common_CreatedBy}" Width="Auto" MinWidth="80" Binding="{Binding CreatedBy}"
                                                ElementStyle="{StaticResource Cell.Secondary}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Style="{StaticResource EmptyState}"
                                Visibility="{Binding ReceiptsView.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="40" Text="{StaticResource Icon.Receipts}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="{x:Static res:Strings.Receipts_EmptyTitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Receipts_EmptyHint}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <HeaderedContentControl Grid.Column="1" Style="{StaticResource SidePanel}"
                                    Header="{Binding Editor.Heading}" Content="{Binding Editor}"
                                    Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
    </Grid>
</UserControl>
