<UserControl x:Class="StockHelper.App.Views.Pages.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
             xmlns:res="clr-namespace:StockHelper.App.Resources"
             xmlns:b="clr-namespace:StockHelper.App.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:UsersViewModel}">
    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Style="{StaticResource PageHeader}" Header="{Binding Title}" Tag="{x:Static res:Strings.Users_Subtitle}">
            <Button Style="{StaticResource Button.AccentIcon}" Tag="{StaticResource Icon.Add}"
                    Content="{x:Static res:Strings.Users_Add}" Command="{Binding AddCommand}" ToolTip="{x:Static res:Strings.Tip_UserAdd}" />
        </HeaderedContentControl>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.Flush}">
                <DataGrid Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" b:GridBehavior.RowClickCommand="{Binding EditCommand}">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Users_User}" Width="2*" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,6">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Icon.User}" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding DisplayName}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Login}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Users_Role}" Width="*" SortMemberPath="Role">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge.Accent}" Margin="8,0">
                                        <TextBlock Text="{Binding Role, Converter={StaticResource EnumDisplay}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{x:Static res:Strings.Common_Status}" Width="*" SortMemberPath="IsActive">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,0" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Badge.Success}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Static res:Strings.Users_Active}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="{x:Static res:Strings.Users_Inactive}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <HeaderedContentControl Grid.Column="1" Style="{StaticResource SidePanel}"
                                    Header="{Binding Editor.Heading}" Content="{Binding Editor}"
                                    Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
    </Grid>
</UserControl>
