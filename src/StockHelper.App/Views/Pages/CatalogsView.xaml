<UserControl x:Class="StockHelper.App.Views.Pages.CatalogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:StockHelper.App.Controls"
             xmlns:res="clr-namespace:StockHelper.App.Resources"
             xmlns:b="clr-namespace:StockHelper.App.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:CatalogsViewModel}">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type pages:LookupSectionViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Style="{StaticResource Toolbar}">
                    <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Common_Search}" />
                    <CheckBox Content="{x:Static res:Strings.Common_ShowArchived}" IsChecked="{Binding ShowArchived}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.AccentIcon}" Tag="{StaticResource Icon.Add}" Margin="{StaticResource Space.ButtonGap}"
                            Content="{x:Static res:Strings.Common_Add}" Command="{Binding AddCommand}" ToolTip="{x:Static res:Strings.Tip_Add}"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Export}"
                            Content="{x:Static res:Strings.Common_ExportExcel}" Command="{Binding ExportCommand}" ToolTip="{x:Static res:Strings.Tip_Export}" />
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card.Flush}">
                        <Grid>
                            <DataGrid Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" b:GridBehavior.RowClickCommand="{Binding EditCommand}">
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{x:Static res:Strings.Common_Name}" Width="*" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="8,6" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" />
                                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                                Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{x:Static res:Strings.Common_Archived}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Description}" Margin="0,2,0,0"
                                                               Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Style="{StaticResource EmptyState}"
                                        Visibility="{Binding RowsView.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                           Text="{Binding IconKey, Converter={StaticResource ResourceKeyToValue}}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Common_NothingFound}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <HeaderedContentControl Grid.Column="1" Style="{StaticResource SidePanel}"
                                            Header="{Binding Editor.Heading}" Content="{Binding Editor}"
                                            Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Style="{StaticResource PageHeader}" Header="{Binding Title}" Tag="{Binding SelectedSection.Hint}" />

        <ListBox Grid.Row="1" Style="{StaticResource SegmentedList}" Margin="0,0,0,16"
                 ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="{StaticResource FontSize.Caption}" Margin="0,0,8,0"
                                   Text="{Binding IconKey, Converter={StaticResource ResourceKeyToValue}}" />
                        <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ContentControl Grid.Row="2" Content="{Binding SelectedSection}" Focusable="False" b:Motion.OnContentChange="FadeUp" />
    </Grid>
</UserControl>
