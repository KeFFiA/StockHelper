<UserControl x:Class="StockHelper.App.Views.Pages.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:StockHelper.App.Controls"
             xmlns:res="clr-namespace:StockHelper.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:ReportsViewModel}">
    <UserControl.Resources>
        <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource Cell.Number}" />

        <!-- ===== Stock & forecast ===== -->
        <DataTemplate DataType="{x:Type pages:StockReportSection}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                    <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Items_SearchPlaceholder}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </DockPanel>
                <Border Style="{StaticResource Card.Flush}">
                    <DataGrid Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding RowsView}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Items_Name}" Width="2*" MinWidth="200" SortMemberPath="Item.Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Item.Name}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Item.Category.Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_EstimatedStock}" Width="Auto" MinWidth="130" SortMemberPath="EstimatedStock"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right">
                                                <Run Text="{Binding EstimatedStock, Mode=OneWay, Converter={StaticResource Decimal}}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Item.Unit.Name, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                                       Text="{x:Static res:Strings.Reports_NoBaseline}"
                                                       Visibility="{Binding HasBaseline, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static res:Strings.Items_MinStock}" Width="Auto" MinWidth="100" SortMemberPath="Item.MinStock"
                                                HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                Binding="{Binding Item.MinStock, Converter={StaticResource Decimal}}" ElementStyle="{StaticResource Cell.Number}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Reports_LastCountDate}" Width="Auto" MinWidth="110" SortMemberPath="LastCountDate"
                                                Binding="{Binding LastCountDate, Converter={StaticResource UtcToLocal}, ConverterParameter=d}"
                                                ElementStyle="{StaticResource Cell.Secondary}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Reports_AvgDaily}" Width="Auto" MinWidth="110" SortMemberPath="AverageDailyConsumption"
                                                HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                Binding="{Binding AverageDailyConsumption, Converter={StaticResource Decimal}, ConverterParameter=#\,0.##}"
                                                ElementStyle="{StaticResource Cell.Number}" />
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_Forecast}" Width="Auto" MinWidth="150" SortMemberPath="DaysLeft">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="8,0" Content="{Binding}" ContentTemplate="{StaticResource DaysLeftBadge}" Focusable="False" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static res:Strings.Reports_RunOutDate}" Width="Auto" MinWidth="110" SortMemberPath="RunOutDate"
                                                Binding="{Binding RunOutDate, Converter={StaticResource UtcToLocal}, ConverterParameter=d}"
                                                ElementStyle="{StaticResource Cell.Secondary}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- ===== Purchase list ===== -->
        <DataTemplate DataType="{x:Type pages:PurchaseReportSection}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                    <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Items_SearchPlaceholder}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </DockPanel>
                <Border Style="{StaticResource Card.Flush}">
                    <Grid>
                        <DataGrid Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding RowsView}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Items_Name}" Width="2*" MinWidth="200" SortMemberPath="Item.Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8,6" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Item.Name}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Item.Category.Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_Reason}" Width="Auto" MinWidth="150" SortMemberPath="DaysLeft">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Margin="8,0" Content="{Binding}" ContentTemplate="{StaticResource DaysLeftBadge}" Focusable="False" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.Reports_EstimatedStock}" Width="Auto" MinWidth="110" SortMemberPath="EstimatedStock"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding EstimatedStock, Converter={StaticResource Decimal}}" ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Items_MinStock}" Width="Auto" MinWidth="100" SortMemberPath="Item.MinStock"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding Item.MinStock, Converter={StaticResource Decimal}}" ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_Suggested}" Width="Auto" MinWidth="130" SortMemberPath="SuggestedQuantity"
                                                        HeaderStyle="{StaticResource Grid.HeaderRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Cell.Number}">
                                                <Run Text="{Binding SuggestedQuantity, Mode=OneWay, Converter={StaticResource Decimal}}" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <Run Text="{Binding Item.Unit.Name, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.Items_Price}" Width="Auto" MinWidth="90" SortMemberPath="Item.Price"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding Item.Price, Converter={StaticResource Decimal}, ConverterParameter=#\,0.00}"
                                                    ElementStyle="{StaticResource Cell.Number}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding RowsView.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="40" Text="{StaticResource Icon.Success}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{x:Static res:Strings.Reports_PurchaseEmpty}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- ===== Consumption ===== -->
        <DataTemplate DataType="{x:Type pages:ConsumptionReportSection}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                    <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Items_SearchPlaceholder}" Width="220" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Common_From}" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="140" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Common_To}" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="140" />
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="3" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.Period_30}" Command="{Binding SetPeriodCommand}" CommandParameter="30" />
                            <Button Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.Period_90}" Command="{Binding SetPeriodCommand}" CommandParameter="90" />
                            <Button Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.Period_365}" Command="{Binding SetPeriodCommand}" CommandParameter="365" />
                            <Button Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.Period_All}" Command="{Binding SetPeriodCommand}" CommandParameter="0" />
                        </StackPanel>
                    </Border>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" Margin="0,0,0,12" />
                <Border Style="{StaticResource Card.Flush}">
                    <Grid>
                        <DataGrid Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding RowsView}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Items_Name}" Width="2*" MinWidth="200" SortMemberPath="Item.Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8,6" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Item.Name}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Item.Category.Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_ConsumptionQty}" Width="Auto" MinWidth="130" SortMemberPath="Consumption"
                                                        HeaderStyle="{StaticResource Grid.HeaderRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="Value" Style="{StaticResource Cell.Number}">
                                                <Run Text="{Binding Consumption, Mode=OneWay, Converter={StaticResource Decimal}}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Item.Unit.Name, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.Reports_Cost}" Width="Auto" MinWidth="110" SortMemberPath="Cost"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding Cost, Converter={StaticResource Decimal}, ConverterParameter=#\,0.00}" ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Reports_AvgDaily}" Width="Auto" MinWidth="110" SortMemberPath="AverageDaily"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding AverageDaily, Converter={StaticResource Decimal}, ConverterParameter=#\,0.##}" ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Reports_Days}" Width="Auto" MinWidth="70" SortMemberPath="Days"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding Days, Converter={StaticResource Decimal}, ConverterParameter=#\,0}" ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_Discrepancy}" Width="Auto" MinWidth="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge.Danger}" Margin="8,0"
                                                    Visibility="{Binding HasDiscrepancy, Converter={StaticResource BoolToVisibility}}"
                                                    ToolTip="{x:Static res:Strings.Reports_DiscrepancyHint}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="{StaticResource Icon.Warning}" Margin="0,0,5,0" />
                                                    <TextBlock Text="{x:Static res:Strings.Reports_DiscrepancyBadge}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding RowsView.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="40" Text="{StaticResource Icon.Trend}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Reports_ConsumptionEmpty}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- ===== History ===== -->
        <DataTemplate DataType="{x:Type pages:HistoryReportSection}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource Toolbar}">
                    <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Items_SearchPlaceholder}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </DockPanel>
                <Border Style="{StaticResource Card.Flush}">
                    <Grid>
                        <DataGrid Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding RowsView}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Items_Name}" Width="2*" MinWidth="180" SortMemberPath="ItemName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="8,6" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding ItemName}" />
                                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CategoryName}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_Period}" Width="Auto" MinWidth="180" SortMemberPath="Period.To">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Cell.Secondary}">
                                                <Run Text="{Binding Period.From, Mode=OneWay, Converter={StaticResource UtcToLocal}, ConverterParameter=d}" />
                                                <Run Text="→" />
                                                <Run Text="{Binding Period.To, Mode=OneWay, Converter={StaticResource UtcToLocal}, ConverterParameter=d}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static res:Strings.Reports_Opening}" Width="Auto" MinWidth="90" HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding Period.OpeningStock, Converter={StaticResource Decimal}}" ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Reports_Received}" Width="Auto" MinWidth="90" HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding Period.Received, Converter={StaticResource Decimal}, ConverterParameter=+#\,0.####;−#\,0.####;0}"
                                                    ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTextColumn Header="{x:Static res:Strings.Reports_Closing}" Width="Auto" MinWidth="90" HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    Binding="{Binding Period.ClosingStock, Converter={StaticResource Decimal}}" ElementStyle="{StaticResource Cell.Number}" />
                                <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_ConsumptionQty}" Width="Auto" MinWidth="120" SortMemberPath="Period.Consumption"
                                                        HeaderStyle="{StaticResource Grid.HeaderRight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="Value" Style="{StaticResource Cell.Number}" FontWeight="SemiBold">
                                                <Run Text="{Binding Period.Consumption, Mode=OneWay, Converter={StaticResource Decimal}}" />
                                                <Run Text="{Binding UnitName, Mode=OneWay}" FontWeight="Normal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Period.IsDiscrepancy}" Value="True">
                                                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Setter TargetName="Value" Property="ToolTip" Value="{x:Static res:Strings.Reports_DiscrepancyHint}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding RowsView.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="40" Text="{StaticResource Icon.History}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Reports_HistoryEmpty}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Margin="0,16,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Style="{StaticResource PageHeader}" Header="{Binding Title}" Tag="{Binding Subtitle}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Refresh}" ToolTip="{x:Static res:Strings.Common_Refresh}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Export}" Content="{x:Static res:Strings.Reports_ExportAll}"
                        Command="{Binding ExportAllCommand}" />
                <Button Style="{StaticResource Button.AccentIcon}" Tag="{StaticResource Icon.Export}" Margin="{StaticResource Space.ButtonGap}"
                        Content="{x:Static res:Strings.Common_ExportExcel}" Command="{Binding ExportCommand}" />
            </StackPanel>
        </HeaderedContentControl>

        <ListBox Grid.Row="1" Style="{StaticResource SegmentedList}" Margin="0,0,0,8" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="{StaticResource FontSize.Caption}" Margin="0,0,8,0"
                                   Text="{Binding IconKey, Converter={StaticResource ResourceKeyToValue}}" />
                        <TextBlock Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" Text="{Binding SelectedSection.Hint}" Margin="0,0,0,16" TextWrapping="Wrap" />

        <ContentControl Grid.Row="3" Content="{Binding SelectedSection}" Focusable="False" />
    </Grid>
</UserControl>
