<UserControl x:Class="StockHelper.App.Views.Pages.StockTakeSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:StockHelper.App.Controls"
             xmlns:res="clr-namespace:StockHelper.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:StockTakeSessionViewModel}">
    <UserControl.Resources>
        <!-- Column layout shared by the header and every row. -->
        <GridLength x:Key="Col.Unit">72</GridLength>
        <GridLength x:Key="Col.Count">230</GridLength>
        <GridLength x:Key="Col.Number">120</GridLength>

        <Style x:Key="RowContainer" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Divider}">
                            <Grid>
                                <Border x:Name="Focus" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="0.12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Left" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Back}" Margin="-6,0,8,0" VerticalAlignment="Center"
                    ToolTip="{x:Static res:Strings.Tip_Back}" Command="{Binding BackCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Delete}" ToolTip="{x:Static res:Strings.StockTakes_DeleteDraft}"
                        Command="{Binding DeleteCommand}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Export}" Margin="8,0,0,0"
                        Content="{x:Static res:Strings.Common_ExportExcel}" Command="{Binding ExportCommand}" ToolTip="{x:Static res:Strings.Tip_Export}" />
                <Button Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Unlock}" Margin="8,0,0,0"
                        Content="{x:Static res:Strings.StockTakes_Reopen}" Command="{Binding ReopenCommand}" ToolTip="{x:Static res:Strings.Tip_Reopen}"
                        Visibility="{Binding CanReopen, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource Button.AccentIcon}" Tag="{StaticResource Icon.Check}" Margin="8,0,0,0"
                        Content="{x:Static res:Strings.StockTakes_Complete}" Command="{Binding CompleteCommand}" ToolTip="{x:Static res:Strings.Tip_Complete}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Heading}" />
                <Border x:Name="StatusBadge" Margin="12,6,0,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Badge.Warning}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="{StaticResource Icon.Lock}" Margin="0,0,6,0"
                                   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StatusText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Parameters + progress -->
        <Border Grid.Row="1" Style="{StaticResource Card.Compact}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.StockTakes_Date}" />
                    <DatePicker SelectedDate="{Binding Date}" />
                </StackPanel>
                <StackPanel Grid.Column="2" IsEnabled="{Binding CanEdit}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Common_Time}" />
                    <TextBox Text="{Binding Time, UpdateSourceTrigger=LostFocus}" HorizontalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="4" IsEnabled="{Binding CanEdit}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Items_Note}" />
                    <TextBox x:Name="NoteBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnNoteLostFocus" />
                </StackPanel>
                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Progress}" Margin="0,0,0,8" />
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="4" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:Strings.StockTakes_Autosave}" Margin="0,6,0,0"
                               Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Border Grid.Row="1" Grid.ColumnSpan="7" Style="{StaticResource InfoBar.Error}" Margin="0,12,0,0"
                        Visibility="{Binding HeaderError, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding HeaderError}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- Location + filters -->
        <DockPanel Grid.Row="2" Style="{StaticResource Toolbar}">
            <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.StockTakes_Location}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ListBox Style="{StaticResource SegmentedList}" ItemsSource="{Binding Locations}" SelectedItem="{Binding Location}" MaxWidth="560">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="{StaticResource FontSize.Caption}" Text="{StaticResource Icon.Location}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <CheckBox DockPanel.Dock="Right" Content="{x:Static res:Strings.StockTakes_OnlyUncounted}" IsChecked="{Binding OnlyUncounted}"
                      VerticalAlignment="Center" Margin="16,0,0,0" />
            <controls:SearchBox DockPanel.Dock="Right" Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Items_SearchPlaceholder}" />
        </DockPanel>

        <!-- Count table -->
        <Border Grid.Row="3" Style="{StaticResource Card.Flush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Divider}"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="16,10" CornerRadius="8,8,0,0">
                    <Grid TextElement.FontWeight="SemiBold" TextElement.FontSize="{StaticResource FontSize.Caption}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource Col.Unit}" />
                            <ColumnDefinition Width="{StaticResource Col.Count}" />
                            <ColumnDefinition Width="{StaticResource Col.Number}" />
                            <ColumnDefinition Width="{StaticResource Col.Number}" />
                            <ColumnDefinition Width="{StaticResource Col.Number}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.Items_Name}" />
                        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Items_Unit}" />
                        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.StockTakes_CountHere}" HorizontalAlignment="Right" Margin="0,0,12,0" ToolTip="{x:Static res:Strings.Tip_CountHere}" />
                        <TextBlock Grid.Column="3" Text="{x:Static res:Strings.StockTakes_Total}" HorizontalAlignment="Right" ToolTip="{x:Static res:Strings.Tip_TotalAllLocations}" />
                        <TextBlock Grid.Column="4" Text="{x:Static res:Strings.StockTakes_Expected}" HorizontalAlignment="Right"
                                   ToolTip="{x:Static res:Strings.StockTakes_ExpectedHint}" />
                        <TextBlock Grid.Column="5" Text="{x:Static res:Strings.StockTakes_Difference}" HorizontalAlignment="Right" ToolTip="{x:Static res:Strings.Tip_Difference}" />
                    </Grid>
                </Border>

                <Grid>
                    <ListBox x:Name="RowsList" ItemsSource="{Binding RowsView}" ItemContainerStyle="{StaticResource RowContainer}"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" KeyboardNavigation.TabNavigation="Continue">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:StockTakeRow}">
                                <Grid Margin="16,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource Col.Unit}" />
                                        <ColumnDefinition Width="{StaticResource Col.Count}" />
                                        <ColumnDefinition Width="{StaticResource Col.Number}" />
                                        <ColumnDefinition Width="{StaticResource Col.Number}" />
                                        <ColumnDefinition Width="{StaticResource Col.Number}" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CategoryName}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding UnitName}" VerticalAlignment="Center" />
                                    <Grid Grid.Column="2" Margin="0,0,4,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="1" Margin="6,0,0,0" MinWidth="80" ItemsSource="{Binding Units}" DisplayMemberPath="Name"
                                                  SelectedItem="{Binding CountUnit}" IsEnabled="{Binding IsEditable}" IsTabStop="False"
                                                  ToolTip="{x:Static res:Strings.StockTakes_CountUnitHint}"
                                                  Visibility="{Binding HasUnitChoice, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Text.Caption}" Text="{Binding CountHint}" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{Binding CountHint, Converter={StaticResource NullToCollapsed}}" />
                                        <TextBox x:Name="CountBox" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                                                 HorizontalContentAlignment="Right"
                                                 PreviewKeyDown="OnCountKeyDown" LostKeyboardFocus="OnCountLostFocus" GotKeyboardFocus="OnCountGotFocus"
                                                 ToolTip="{Binding Error}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="{StaticResource Icon.Check}" FontSize="{StaticResource FontSize.Caption}"
                                                   HorizontalAlignment="Center" IsHitTestVisible="False"
                                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                   Visibility="{Binding JustSaved, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="{StaticResource Icon.Error}" FontSize="{StaticResource FontSize.Caption}"
                                                   HorizontalAlignment="Center" ToolTip="{Binding Error}"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Style="{StaticResource Text.BodyStrong}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Total, Converter={StaticResource Decimal}}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Expected, Converter={StaticResource Decimal}}" />
                                    <Border Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="{Binding HasDifference, Converter={StaticResource BoolToVisibility}}"
                                            Style="{StaticResource Badge.Warning}">
                                        <TextBlock Text="{Binding Difference, Converter={StaticResource Decimal}, ConverterParameter=+#\,0.####;−#\,0.####;0}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding RowsView.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="40" Text="{StaticResource Icon.Search}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Common_NothingFound}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
