<UserControl x:Class="StockHelper.App.Views.Pages.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:StockHelper.App.Controls"
             xmlns:res="clr-namespace:StockHelper.App.Resources"
             xmlns:b="clr-namespace:StockHelper.App.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:ItemsViewModel}">
    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Style="{StaticResource PageHeader}" Header="{Binding Title}" Tag="{Binding Summary}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Export}"
                        Content="{x:Static res:Strings.Common_ExportExcel}" Command="{Binding ExportCommand}" ToolTip="{x:Static res:Strings.Tip_Export}" />
                <Button Style="{StaticResource Button.AccentIcon}" Tag="{StaticResource Icon.Add}" Margin="{StaticResource Space.ButtonGap}"
                        Content="{x:Static res:Strings.Items_Add}" Command="{Binding AddCommand}" ToolTip="{x:Static res:Strings.Tip_ItemAdd}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </HeaderedContentControl>

        <DockPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Items_SearchPlaceholder}" />

            <Grid Width="220" Margin="12,0,0,0">
                <ComboBox ItemsSource="{Binding FilterCategories}" DisplayMemberPath="Name" SelectedItem="{Binding CategoryFilter}" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Items_AllCategories}" Margin="12,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding CategoryFilter, Converter={StaticResource NotNullToCollapsed}}" />
            </Grid>
            <Button Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Cancel}" FontSize="{StaticResource FontSize.Caption}"
                    Margin="4,0,0,0" ToolTip="{x:Static res:Strings.Common_ResetFilter}" Command="{Binding ClearCategoryFilterCommand}"
                    Visibility="{Binding CategoryFilter, Converter={StaticResource NullToCollapsed}}" />

            <CheckBox Content="{x:Static res:Strings.Common_ShowArchived}" IsChecked="{Binding ShowArchived}" Margin="16,0,0,0" VerticalAlignment="Center" />

            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Refresh}"
                    ToolTip="{x:Static res:Strings.Tip_Refresh}" Command="{Binding LoadCommand}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.Flush}">
                <Grid>
                    <DataGrid x:Name="Grid" Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding ItemsView}"
                              SelectedItem="{Binding SelectedItem}" b:GridBehavior.RowClickCommand="{Binding EditCommand}">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Items_Name}" Width="2*" MinWidth="180" SortMemberPath="Item.Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Item.Name}" />
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                    Visibility="{Binding Item.IsArchived, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{x:Static res:Strings.Common_Archived}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static res:Strings.Items_Code}" Width="*" MinWidth="90" Binding="{Binding Item.Code}"
                                                ElementStyle="{StaticResource Cell.Secondary}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Items_Category}" Width="1.2*" MinWidth="130" Binding="{Binding Item.Category.Name}"
                                                ElementStyle="{StaticResource Cell.Text}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Items_Unit}" Width="Auto" MinWidth="70" Binding="{Binding Item.Unit.Name}"
                                                ElementStyle="{StaticResource Cell.Secondary}" />
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_EstimatedStock}" Width="Auto" MinWidth="120" HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                    SortMemberPath="Status.EstimatedStock">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Cell.Number}" FontWeight="SemiBold"
                                                   Text="{Binding Status.EstimatedStock, Converter={StaticResource Decimal}}"
                                                   ToolTip="{x:Static res:Strings.Reports_EstimatedNote}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Reports_Forecast}" Width="Auto" MinWidth="130" SortMemberPath="Status.DaysLeft">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="8,0" Content="{Binding Status}" ContentTemplate="{StaticResource DaysLeftBadge}" Focusable="False"
                                                        Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static res:Strings.Items_MinStock}" Width="Auto" MinWidth="100" SortMemberPath="Item.MinStock" HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                Binding="{Binding Item.MinStock, Converter={StaticResource Decimal}}" ElementStyle="{StaticResource Cell.Number}" />
                            <DataGridTextColumn Header="{x:Static res:Strings.Items_Price}" Width="Auto" MinWidth="96" SortMemberPath="Item.Price" HeaderStyle="{StaticResource Grid.HeaderRight}"
                                                Binding="{Binding Item.Price, Converter={StaticResource Money}}"
                                                ElementStyle="{StaticResource Cell.Number}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Style="{StaticResource EmptyState}"
                                Visibility="{Binding ItemsView.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="40" Text="{StaticResource Icon.Items}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="{x:Static res:Strings.Items_EmptyTitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Items_EmptyHint}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <HeaderedContentControl Grid.Column="1" Style="{StaticResource SidePanel}"
                                    Header="{Binding Editor.Heading}" Content="{Binding Editor}"
                                    Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
    </Grid>
</UserControl>
