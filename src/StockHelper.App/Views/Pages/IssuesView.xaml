<UserControl x:Class="StockHelper.App.Views.Pages.IssuesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:StockHelper.App.Controls"
             xmlns:res="clr-namespace:StockHelper.App.Resources"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance pages:IssuesViewModel}">
    <Grid Margin="{StaticResource Space.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <HeaderedContentControl Style="{StaticResource PageHeader}" Header="{Binding Title}" Tag="{Binding Summary}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Export}"
                        Content="{x:Static res:Strings.Common_ExportExcel}" Command="{Binding ExportCommand}"
                        ToolTip="{x:Static res:Strings.Tip_Export}" />
                <Button Style="{StaticResource Button.AccentIcon}" Tag="{StaticResource Icon.Issue}" Margin="{StaticResource Space.ButtonGap}"
                        Content="{x:Static res:Strings.Issues_Add}" Command="{Binding AddCommand}" ToolTip="{x:Static res:Strings.Tip_IssueAdd}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </HeaderedContentControl>

        <DockPanel Grid.Row="1" Style="{StaticResource Toolbar}">
            <controls:SearchBox Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{x:Static res:Strings.Issues_SearchPlaceholder}" />

            <Border Background="{DynamicResource Brush.SegmentBackground}" CornerRadius="6" Padding="3" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="IssuesMode" IsChecked="{Binding OnlyOnHand, Converter={StaticResource InverseBool}}"
                                 ToolTip="{x:Static res:Strings.Tip_IssuesAll}">
                        <TextBlock Text="{x:Static res:Strings.Issues_All}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource Segment}" GroupName="IssuesMode" IsChecked="{Binding OnlyOnHand}"
                                 ToolTip="{x:Static res:Strings.Tip_IssuesOnHand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static res:Strings.Issues_OnHand}" />
                            <Border Style="{StaticResource Badge.Warning}" Margin="6,0,0,0" Padding="6,0"
                                    Visibility="{Binding OnHandCount, Converter={StaticResource ZeroToCollapsed}}">
                                <TextBlock Text="{Binding OnHandCount}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPeriodVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Common_From}" VerticalAlignment="Center" Margin="16,0,8,0" />
                <DatePicker SelectedDate="{Binding FromDate}" Width="140" />
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Common_To}" VerticalAlignment="Center" Margin="12,0,8,0" />
                <DatePicker SelectedDate="{Binding ToDate}" Width="140" />
            </StackPanel>

            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Refresh}"
                    ToolTip="{x:Static res:Strings.Tip_Refresh}" Command="{Binding LoadCommand}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card.Flush}">
                <Grid>
                    <DataGrid Style="{StaticResource Grid.ReadOnly}" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}" />
                            <KeyBinding Key="Enter" Command="{Binding EditCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static res:Strings.Receipts_Date}" Width="Auto" MinWidth="130" SortMemberPath="Date"
                                                Binding="{Binding Date, Converter={StaticResource UtcToLocal}, ConverterParameter=g}"
                                                ElementStyle="{StaticResource Cell.Secondary}" />
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Items_Name}" Width="2*" MinWidth="180" SortMemberPath="Item.Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Item.Name}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Note}"
                                                       Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Issues_Issued}" Width="Auto" MinWidth="110" SortMemberPath="Quantity"
                                                    HeaderStyle="{StaticResource Grid.HeaderRight}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right">
                                                <Run Text="{Binding Quantity, Mode=OneWay, Converter={StaticResource Decimal}}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Item.Unit.Name, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                                                       Text="{Binding Converter={StaticResource Entered}}"
                                                       Visibility="{Binding UnitId, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static res:Strings.Issues_To}" Width="*" MinWidth="120" Binding="{Binding IssuedTo}"
                                                ElementStyle="{StaticResource Cell.Text}" />
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Common_Status}" Width="Auto" MinWidth="170" SortMemberPath="ReturnedAt">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,0" VerticalAlignment="Center">
                                            <Border x:Name="Badge" Style="{StaticResource Badge}" ToolTip="{x:Static res:Strings.Tip_IssueConsumed}">
                                                <TextBlock x:Name="Label" Text="{x:Static res:Strings.Issues_StatusIssued}" />
                                            </Border>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOnHand}" Value="True">
                                                <Setter TargetName="Badge" Property="Style" Value="{StaticResource Badge.Warning}" />
                                                <Setter TargetName="Label" Property="Text" Value="{x:Static res:Strings.Issues_StatusOnHand}" />
                                                <Setter TargetName="Badge" Property="ToolTip" Value="{x:Static res:Strings.Tip_IssueOnHand}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsReturned}" Value="True">
                                                <Setter TargetName="Badge" Property="Style" Value="{StaticResource Badge.Success}" />
                                                <Setter TargetName="Label" Property="Text" Value="{Binding Converter={StaticResource Returned}}" />
                                                <Setter TargetName="Badge" Property="ToolTip" Value="{Binding ReturnedAt, Converter={StaticResource UtcToLocal}, ConverterParameter=g}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="Auto" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.SubtleIcon}" Tag="{StaticResource Icon.Restore}" Margin="4,0"
                                                Content="{x:Static res:Strings.Issues_ReturnShort}" ToolTip="{x:Static res:Strings.Tip_IssueReturn}"
                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                Command="{Binding DataContext.ReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsOnHand, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding IssuesView.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="40" Text="{StaticResource Icon.Issue}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Style="{StaticResource Text.Subtitle}" Text="{x:Static res:Strings.Issues_EmptyTitle}" HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Issues_EmptyHint}" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" />
                    </StackPanel>
                </Grid>
            </Border>

            <HeaderedContentControl Grid.Column="1" Style="{StaticResource SidePanel}"
                                    Header="{Binding Editor.Heading}" Content="{Binding Editor}"
                                    Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}" />
        </Grid>
    </Grid>
</UserControl>
