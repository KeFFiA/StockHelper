<!-- Maps page view models to views and holds shared item templates. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:StockHelper.App.ViewModels"
                    xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
                    xmlns:views="clr-namespace:StockHelper.App.Views.Pages"
                    xmlns:svc="clr-namespace:StockHelper.App.Services"
                    xmlns:res="clr-namespace:StockHelper.App.Resources">

    <!-- ===== Pages ===== -->
    <DataTemplate DataType="{x:Type pages:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ItemsViewModel}">
        <views:ItemsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:CatalogsViewModel}">
        <views:CatalogsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ReceiptsViewModel}">
        <views:ReceiptsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:StockTakesViewModel}">
        <views:StockTakesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ReportsViewModel}">
        <views:ReportsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:UsersViewModel}">
        <views:UsersView />
    </DataTemplate>

    <!-- ===== Analytics ===== -->
    <!-- Forecast badge for an ItemStockStatus: below minimum / running out / ok / no data. -->
    <DataTemplate x:Key="DaysLeftBadge">
        <Border x:Name="Badge" Style="{StaticResource Badge.Success}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,5,0" Text="{StaticResource Icon.Trend}" />
                <TextBlock x:Name="Label" Text="{Binding DaysLeft, Converter={StaticResource Days}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding DaysLeft}" Value="{x:Null}">
                <Setter TargetName="Badge" Property="Style" Value="{StaticResource Badge}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRunningOut}" Value="True">
                <Setter TargetName="Badge" Property="Style" Value="{StaticResource Badge.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBelowMinimum}" Value="True">
                <Setter TargetName="Badge" Property="Style" Value="{StaticResource Badge.Danger}" />
                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Warning}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Shell ===== -->
    <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItem}">
        <RadioButton Style="{StaticResource NavItem}" GroupName="ShellNavigation"
                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                     CommandParameter="{Binding}"
                     ToolTip="{Binding Title}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding IconKey, Converter={StaticResource ResourceKeyToValue}}" Margin="{StaticResource Space.IconGap}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
        </RadioButton>
    </DataTemplate>

    <DataTemplate x:Key="ShellUserTemplate" DataType="{x:Type vm:ShellViewModel}">
        <Border Margin="0,12,0,0" Padding="10,10,4,10" CornerRadius="{StaticResource Radius.Card}"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="{Binding UserInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding UserName}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding UserRole, Converter={StaticResource EnumDisplay}}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.SignOut}"
                        ToolTip="{x:Static res:Strings.Shell_SignOut}" Command="{Binding SignOutCommand}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="NotificationTemplate" DataType="{x:Type svc:Notification}">
        <Border x:Name="Root" Style="{StaticResource Card.Compact}" Margin="0,8,0,0" MinWidth="320"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,12,0"
                           Text="{StaticResource Icon.Info}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}" />
                    <Button Style="{StaticResource Button.Accent}" Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Cancel}"
                        Width="28" Height="28" FontSize="{StaticResource FontSize.Caption}" VerticalAlignment="Top" Margin="8,-4,-8,0"
                        Command="{Binding DismissCommand}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Success}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Warning}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter TargetName="Glyph" Property="Text" Value="{StaticResource Icon.Error}" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
