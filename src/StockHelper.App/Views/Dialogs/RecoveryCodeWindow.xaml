<Window x:Class="StockHelper.App.Views.Dialogs.RecoveryCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:StockHelper.App.Behaviors"
        xmlns:res="clr-namespace:StockHelper.App.Resources"
        Title="{x:Static res:Strings.Recovery_Title}"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource FontSize.Body}">
    <Grid Margin="20" b:Motion.OnLoaded="Pop">
        <Border CornerRadius="12" Background="{DynamicResource Brush.CardBackground}" Effect="{DynamicResource Effect.Toast}" />
        <Border CornerRadius="12" Background="{DynamicResource Brush.CardBackground}" BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1">
            <StackPanel>
                <StackPanel Margin="28,24,28,20">
                    <!-- Header: drag to move -->
                    <DockPanel Background="Transparent" MouseLeftButtonDown="OnDrag">
                        <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,16,0">
                            <Border CornerRadius="22" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                            <TextBlock Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" Text="{StaticResource Icon.Key}"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Subtitle}" Text="{x:Static res:Strings.Recovery_Title}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="{x:Static res:Strings.Recovery_Subtitle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Style="{StaticResource Text.Body}" Text="{x:Static res:Strings.Recovery_Text}" TextWrapping="Wrap" Margin="0,20,0,16" />

                    <Border CornerRadius="{StaticResource Radius.Control}" Background="{DynamicResource Brush.ContentBackground}"
                            BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="1" Padding="16,14">
                        <TextBox x:Name="CodeBox" IsReadOnly="True" HorizontalContentAlignment="Center" BorderThickness="0" Background="Transparent"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="24" FontWeight="SemiBold" Padding="0" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="CopyButton" Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Copy}"
                                Content="{x:Static res:Strings.Recovery_Copy}" Click="OnCopy" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.StandardIcon}" Tag="{StaticResource Icon.Save}"
                                Content="{x:Static res:Strings.Recovery_SaveFile}" Click="OnSave" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:Strings.Recovery_Hint}" TextWrapping="Wrap" Margin="0,16,0,0" />
                </StackPanel>

                <Border Background="{DynamicResource Brush.ContentBackground}" CornerRadius="0,0,12,12"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="24,14">
                    <DockPanel>
                        <Button x:Name="DoneButton" DockPanel.Dock="Right" Style="{StaticResource Button.Accent}" Content="{x:Static res:Strings.Recovery_Done}"
                                IsEnabled="{Binding IsChecked, ElementName=SavedCheck}" IsDefault="True" Click="OnDone" />
                        <CheckBox x:Name="SavedCheck" Content="{x:Static res:Strings.Recovery_Confirm}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
