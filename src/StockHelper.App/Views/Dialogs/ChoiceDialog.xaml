<Window x:Class="StockHelper.App.Views.Dialogs.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:StockHelper.App.Behaviors"
        xmlns:res="clr-namespace:StockHelper.App.Resources"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource FontSize.Body}">
    <Grid Margin="20" b:Motion.OnLoaded="Pop">
        <Border CornerRadius="12" Background="{DynamicResource Brush.CardBackground}" Effect="{DynamicResource Effect.Toast}" />
        <Border CornerRadius="12" Background="{DynamicResource Brush.CardBackground}" BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1"
                MouseLeftButtonDown="OnDrag">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="28,24,28,12">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Text.Subtitle}" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Wrap}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Option tiles: click or Enter on the focused tile picks it. -->
                <ItemsControl x:Name="Options" Grid.Row="1" Margin="24,4,24,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Subtle}" Padding="0" Margin="0,4" HorizontalContentAlignment="Stretch"
                                    Click="OnOptionClick" Tag="{Binding Index}">
                                <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.CardStroke}" CornerRadius="8" Padding="16,14">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,14,0">
                                            <Border CornerRadius="20" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                                            <TextBlock Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Text="{Binding Icon}"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{StaticResource Icon.ChevronRight}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12,0,0,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Title}" HorizontalAlignment="Left" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="2" Background="{DynamicResource Brush.ContentBackground}" CornerRadius="0,0,12,12"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="24,14">
                    <Button Style="{StaticResource Button.Standard}" Content="{x:Static res:Strings.Common_Cancel}" IsCancel="True" HorizontalAlignment="Right" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
