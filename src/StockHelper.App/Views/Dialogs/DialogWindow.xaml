<Window x:Class="StockHelper.App.Views.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="{StaticResource Size.DialogWidth}"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource FontSize.Body}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText" Style="{StaticResource Icon.Large}" VerticalAlignment="Top" Margin="0,2,14,0" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Wrap}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrimaryButton" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnPrimaryClick" />
                <Button x:Name="SecondaryButton" Style="{StaticResource Button.Standard}" IsCancel="True" Margin="{StaticResource Space.ButtonGap}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
