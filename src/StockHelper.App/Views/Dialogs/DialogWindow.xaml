<Window x:Class="StockHelper.App.Views.Dialogs.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:StockHelper.App.Behaviors"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource FontSize.Body}">
    <!-- Margin leaves room for the soft shadow drawn by a sibling (an effect on the card itself would blur its text). -->
    <Grid Margin="20" b:Motion.OnLoaded="Pop">
        <Border CornerRadius="12" Background="{DynamicResource Brush.CardBackground}" Effect="{DynamicResource Effect.Toast}" />
        <Border CornerRadius="12" Background="{DynamicResource Brush.CardBackground}" BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1"
                MouseLeftButtonDown="OnDrag">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="28,26,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44" VerticalAlignment="Top" Margin="0,0,16,0">
                        <Border x:Name="IconCircle" CornerRadius="22" Opacity="0.14" />
                        <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource Text.Subtitle}" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Wrap}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" LineHeight="20" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource Brush.ContentBackground}" CornerRadius="0,0,12,12"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="24,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SecondaryButton" Style="{StaticResource Button.Standard}" IsCancel="True" Margin="0,0,8,0" />
                        <Button x:Name="PrimaryButton" Style="{StaticResource Button.Accent}" IsDefault="True" Click="OnPrimaryClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
