<Window x:Class="StockHelper.App.Views.Dialogs.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="clr-namespace:StockHelper.App.Behaviors"
        xmlns:res="clr-namespace:StockHelper.App.Resources"
        Width="720" Height="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Text}"
        FontSize="{StaticResource FontSize.Body}">
    <Grid Margin="20" b:Motion.OnLoaded="Pop">
        <Border CornerRadius="12" Background="{DynamicResource Brush.CardBackground}" Effect="{DynamicResource Effect.Toast}" />
        <Border CornerRadius="12" Background="{DynamicResource Brush.CardBackground}" BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: drag to move -->
                <DockPanel Margin="28,24,28,12" Background="Transparent" MouseLeftButtonDown="OnDrag">
                    <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,16,0">
                        <Border CornerRadius="22" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                        <TextBlock Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center" x:Name="IconText"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>

                <FlowDocumentScrollViewer x:Name="Viewer" Grid.Row="1" Margin="28,4,28,0" VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled" IsToolBarVisible="False" Focusable="False" />

                <Border Grid.Row="2" Background="{DynamicResource Brush.ContentBackground}" CornerRadius="0,0,12,12"
                        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="24,14">
                    <Button Style="{StaticResource Button.Accent}" Content="{x:Static res:Strings.Changelog_Ok}" HorizontalAlignment="Right"
                            IsDefault="True" IsCancel="True" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
