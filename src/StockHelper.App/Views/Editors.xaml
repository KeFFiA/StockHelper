<!-- Side-panel editor templates (DataType → form). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:StockHelper.App.ViewModels.Pages"
                    xmlns:res="clr-namespace:StockHelper.App.Resources"
                    xmlns:b="clr-namespace:StockHelper.App.Behaviors">

    <!-- Common footer: Save / Cancel. -->
    <DataTemplate x:Key="EditorErrorTemplate">
        <Border Style="{StaticResource InfoBar.Error}" Visibility="{Binding Converter={StaticResource NullToCollapsed}}">
            <DockPanel>
                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource Icon.Error}" Margin="0,1,8,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- Shared danger zone (archive / delete) for existing records. -->
    <DataTemplate x:Key="DangerZoneTemplate">
        <StackPanel Margin="0,24,0,0">
            <Border Style="{StaticResource Divider}" Margin="0,0,0,12" />
            <Button Style="{StaticResource Button.SubtleIcon}" Tag="{StaticResource Icon.Archive}" Content="{Binding ArchiveText}"
                    Command="{Binding ToggleArchiveCommand}" />
            <Button Style="{StaticResource Button.Danger}" Tag="{StaticResource Icon.Delete}" Content="{x:Static res:Strings.Common_Delete}"
                    Command="{Binding DeleteCommand}" Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>

    <Style x:Key="DangerZoneHost" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Content" Value="{Binding}" />
        <Setter Property="ContentTemplate" Value="{StaticResource DangerZoneTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNew}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding CanEdit}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Item ===== -->
    <DataTemplate DataType="{x:Type pages:ItemEditorViewModel}">
        <StackPanel>
            <StackPanel IsEnabled="{Binding CanEdit}">
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Items_Name}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" b:FocusBehavior.FocusOnLoad="True" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Items_Code}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Items_Category}" />
                    <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding Category}" />
                </StackPanel>
                <Grid Margin="{StaticResource Space.FieldBottom}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Items_Unit}" />
                        <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="Name" SelectedItem="{Binding Unit}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Items_MinStock}" />
                        <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" />
                    </StackPanel>
                </Grid>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Items_Price}" />
                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Right" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:Strings.Items_PriceHint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Items_Note}" />
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                </StackPanel>
            </StackPanel>

            <ContentControl Content="{Binding ErrorMessage}" ContentTemplate="{StaticResource EditorErrorTemplate}" Focusable="False" />

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Accent}" Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}"
                        IsDefault="True" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Standard}" Content="{x:Static res:Strings.Common_Close}" Command="{Binding CancelCommand}" IsCancel="True" />
            </StackPanel>

            <ContentControl Style="{StaticResource DangerZoneHost}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===== Lookup (category / unit / location) ===== -->
    <DataTemplate DataType="{x:Type pages:LookupEditorViewModel}">
        <StackPanel>
            <StackPanel IsEnabled="{Binding CanEdit}">
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Common_Name}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" b:FocusBehavior.FocusOnLoad="True" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Common_Description}" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                </StackPanel>
            </StackPanel>

            <ContentControl Content="{Binding ErrorMessage}" ContentTemplate="{StaticResource EditorErrorTemplate}" Focusable="False" />

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Accent}" Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}"
                        IsDefault="True" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Standard}" Content="{x:Static res:Strings.Common_Close}" Command="{Binding CancelCommand}" IsCancel="True" />
            </StackPanel>

            <ContentControl Style="{StaticResource DangerZoneHost}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===== User ===== -->
    <DataTemplate DataType="{x:Type pages:UserEditorViewModel}">
        <StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Auth_DisplayName}" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" b:FocusBehavior.FocusOnLoad="True" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Auth_Login}" />
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Users_Role}" />
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding RoleDescription}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <CheckBox Content="{x:Static res:Strings.Users_IsActive}" IsChecked="{Binding IsActive}" Margin="{StaticResource Space.FieldBottom}"
                      Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />

            <Border Style="{StaticResource Divider}" Margin="0,0,0,16" />

            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{Binding PasswordLabel}" />
                <PasswordBox b:PasswordBoxBinding.Password="{Binding Password}" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{x:Static res:Strings.Users_PasswordHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="{x:Static res:Strings.Auth_PasswordConfirm}" />
                <PasswordBox b:PasswordBoxBinding.Password="{Binding PasswordConfirm}" />
            </StackPanel>

            <ContentControl Content="{Binding ErrorMessage}" ContentTemplate="{StaticResource EditorErrorTemplate}" Focusable="False" />

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Accent}" Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" IsDefault="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource Button.Standard}" Content="{x:Static res:Strings.Common_Close}" Command="{Binding CancelCommand}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
