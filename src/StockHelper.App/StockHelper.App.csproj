<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>StockHelper.App</RootNamespace>
    <AssemblyName>StockHelper</AssemblyName>
    <!-- dotnet publish -p:DemoBuild=true: separate data folder, sample data and one-click demo accounts. -->
    <DefineConstants Condition="'$(DemoBuild)' == 'true'">$(DefineConstants);DEMO</DefineConstants>
    <StartupObject>StockHelper.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WPF0001: Fluent ThemeMode API is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF implicit usings omit System.IO to avoid clashing with System.Windows.Shapes.Path. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StockHelper.Core\StockHelper.Core.csproj" />
    <ProjectReference Include="..\StockHelper.Data\StockHelper.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <!-- App.xaml is a regular page: the entry point is Program.Main (Velopack must run first). -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>StockHelper.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <StronglyTypedFileName>Resources\Strings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The generated designer is added to Compile by CoreResGen; the XAML temp project (_wpftmp) picks it up via the default glob. -->
  <ItemGroup Condition="!$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <Compile Remove="Resources\Strings.Designer.cs" />
  </ItemGroup>

  <!-- Generate the strongly typed Strings class before XAML compilation so {x:Static res:Strings.X} resolves. -->
  <Target Name="GenerateStringsBeforeMarkup" BeforeTargets="MarkupCompilePass1" DependsOnTargets="SplitResourcesByCulture;CreateManifestResourceNames;CoreResGen" />

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app.ico" />
    <!-- User-facing changelog (Russian): shown once after an update and from Settings. -->
    <EmbeddedResource Include="Resources\Changelog.md" LogicalName="StockHelper.Changelog.md" />
  </ItemGroup>

</Project>
