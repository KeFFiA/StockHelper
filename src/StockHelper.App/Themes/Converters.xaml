<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:StockHelper.App.Converters">
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
    <conv:NullToVisibilityConverter x:Key="NotNullToCollapsed" Invert="True" />
    <conv:EmptyToVisibilityConverter x:Key="EmptyToVisible" />
    <conv:UtcToLocalConverter x:Key="UtcToLocal" />
    <conv:ResourceKeyToValueConverter x:Key="ResourceKeyToValue" />
    <conv:EnumDisplayConverter x:Key="EnumDisplay" />
    <conv:DecimalConverter x:Key="Decimal" />
    <conv:DaysConverter x:Key="Days" />
    <conv:EnteredConverter x:Key="Entered" />
    <conv:ReturnedConverter x:Key="Returned" />
    <conv:ZeroToCollapsedConverter x:Key="ZeroToCollapsed" />
</ResourceDictionary>
