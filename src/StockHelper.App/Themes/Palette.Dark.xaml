<!-- Surface palette for the dark theme. Keys must match Palette.Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <SolidColorBrush x:Key="Brush.AppBackground" Color="#1B1C1F" />
    <SolidColorBrush x:Key="Brush.ContentBackground" Color="#222327" />
    <SolidColorBrush x:Key="Brush.ContentStroke" Color="#2F3136" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#2A2B30" />
    <SolidColorBrush x:Key="Brush.CardStroke" Color="#35373D" />
    <SolidColorBrush x:Key="Brush.GridHeader" Color="#303137" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#36383E" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#FFFFFF" Opacity="0.05" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#FFFFFF" Opacity="0.09" />
    <SolidColorBrush x:Key="Brush.SegmentBackground" Color="#2C2D32" />
    <SolidColorBrush x:Key="Brush.SegmentSelected" Color="#3A3C43" />
    <SolidColorBrush x:Key="Brush.Toast" Color="#303137" />
    <DropShadowEffect x:Key="Effect.Toast" Color="#000000" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.45" />
</ResourceDictionary>
