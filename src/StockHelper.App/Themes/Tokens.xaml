<!--
    Design tokens: the single source of truth for typography, spacing, radii, sizes and icons.
    Colors come from the WPF Fluent theme (light/dark aware) and are referenced via DynamicResource
    in Controls.xaml. Views must use styles/tokens from this folder instead of hardcoded values.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Typography -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.BodyLarge">16</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">20</sys:Double>
    <sys:Double x:Key="FontSize.Title">28</sys:Double>
    <sys:Double x:Key="FontSize.Display">36</sys:Double>
    <sys:Double x:Key="FontSize.Icon">16</sys:Double>
    <sys:Double x:Key="FontSize.IconLarge">24</sys:Double>

    <!-- Spacing (4px grid) -->
    <Thickness x:Key="Space.Page">36,28,36,28</Thickness>
    <Thickness x:Key="Space.Card">20,16,20,16</Thickness>
    <Thickness x:Key="Space.CardCompact">16,12,16,12</Thickness>
    <Thickness x:Key="Space.SectionBottom">0,0,0,24</Thickness>
    <Thickness x:Key="Space.ItemBottom">0,0,0,12</Thickness>
    <Thickness x:Key="Space.FieldBottom">0,0,0,16</Thickness>
    <Thickness x:Key="Space.LabelBottom">0,0,0,6</Thickness>
    <Thickness x:Key="Space.ButtonGap">8,0,0,0</Thickness>
    <Thickness x:Key="Space.IconGap">0,0,10,0</Thickness>
    <sys:Double x:Key="Space.Gutter">16</sys:Double>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">12</CornerRadius>

    <!-- Sizes -->
    <GridLength x:Key="Size.NavColumn">248</GridLength>
    <sys:Double x:Key="Size.NavItemHeight">40</sys:Double>
    <sys:Double x:Key="Size.FieldWidth">320</sys:Double>
    <sys:Double x:Key="Size.DialogWidth">440</sys:Double>
    <sys:Double x:Key="Size.SidePanelWidth">380</sys:Double>
    <sys:Double x:Key="Size.ButtonMinWidth">96</sys:Double>
    <sys:Double x:Key="Size.RowHeight">40</sys:Double>

    <!-- Icon glyphs (Segoe Fluent Icons / MDL2 Assets) -->
    <sys:String x:Key="Icon.Home">&#xE80F;</sys:String>
    <sys:String x:Key="Icon.Items">&#xE7B8;</sys:String>
    <sys:String x:Key="Icon.Receipts">&#xE896;</sys:String>
    <sys:String x:Key="Icon.StockTakes">&#xE9D5;</sys:String>
    <sys:String x:Key="Icon.Reports">&#xE9D2;</sys:String>
    <sys:String x:Key="Icon.Catalogs">&#xE8F1;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Icon.Users">&#xE716;</sys:String>
    <sys:String x:Key="Icon.User">&#xE77B;</sys:String>
    <sys:String x:Key="Icon.Location">&#xE707;</sys:String>
    <sys:String x:Key="Icon.Info">&#xE946;</sys:String>
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Error">&#xEA39;</sys:String>
    <sys:String x:Key="Icon.Success">&#xE73E;</sys:String>
    <sys:String x:Key="Icon.Add">&#xE710;</sys:String>
    <sys:String x:Key="Icon.Edit">&#xE70F;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.Save">&#xE74E;</sys:String>
    <sys:String x:Key="Icon.Cancel">&#xE711;</sys:String>
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Excel">&#xE9F9;</sys:String>
    <sys:String x:Key="Icon.Export">&#xEDE1;</sys:String>
    <sys:String x:Key="Icon.Calendar">&#xE787;</sys:String>
    <sys:String x:Key="Icon.Cart">&#xE7BF;</sys:String>
    <sys:String x:Key="Icon.History">&#xE81C;</sys:String>
    <sys:String x:Key="Icon.Archive">&#xE7B8;</sys:String>
    <sys:String x:Key="Icon.Restore">&#xE777;</sys:String>
    <sys:String x:Key="Icon.Lock">&#xE72E;</sys:String>
    <sys:String x:Key="Icon.Unlock">&#xE785;</sys:String>
    <sys:String x:Key="Icon.SignOut">&#xF3B1;</sys:String>
    <sys:String x:Key="Icon.Backup">&#xE8F7;</sys:String>
    <sys:String x:Key="Icon.Update">&#xE895;</sys:String>
    <sys:String x:Key="Icon.Check">&#xE73E;</sys:String>
    <sys:String x:Key="Icon.ChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="Icon.Trend">&#xE8EF;</sys:String>
    <sys:String x:Key="Icon.Money">&#xE825;</sys:String>
    <sys:String x:Key="Icon.Folder">&#xE8B7;</sys:String>
    <sys:String x:Key="Icon.Tag">&#xE8EC;</sys:String>
    <sys:String x:Key="Icon.Ruler">&#xECC6;</sys:String>
</ResourceDictionary>
